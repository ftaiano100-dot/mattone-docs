# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Internal team know-how — versioned in the repo but NOT published on docs.mattone.co.
# Not referenced in docs.json nav either; .mintignore keeps it out of the build entirely
# (pages merely absent from nav would still be reachable by direct URL).
internal/
